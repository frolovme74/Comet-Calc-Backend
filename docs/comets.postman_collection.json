{
  "info": {
    "name": "Comet-Calc API (ЛР4)",
    "description": "Веб-сервис: кометы и расчёт расстояния от Солнца. Авторизация по JWT: запрос аутентификации сохраняет токен в переменную token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET список комет с фильтром по периоду",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/comets?min_orbital_period=6&max_orbital_period=80",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "comets"
          ],
          "query": [
            {
              "key": "min_orbital_period",
              "value": "6"
            },
            {
              "key": "max_orbital_period",
              "value": "80"
            }
          ]
        },
        "description": "Только опубликованные. is_mine = 1, если создатель кометы — текущий пользователь."
      }
    },
    {
      "name": "2. GET лента",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/comets/feed/:id?next=true",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "comets",
            "feed",
            ":id"
          ],
          "query": [
            {
              "key": "next",
              "value": "true",
              "disabled": true,
              "description": "true — вернуть следующую комету после id"
            }
          ],
          "variable": [
            {
              "key": "id",
              "value": "",
              "description": "id кометы; пусто — первая комета ленты"
            }
          ]
        },
        "description": "Одна опубликованная комета. Без id — первая, с id — по id, с ?next=true — следующая после id. is_liked = 1, если текущий пользователь лайкнул комету."
      }
    },
    {
      "name": "3. GET черновик",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201 || pm.response.code === 200) {",
              "    pm.collectionVariables.set('comet_id', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/comets/draft",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "comets",
            "draft"
          ]
        },
        "description": "Черновик текущего пользователя, id не указывается."
      }
    },
    {
      "name": "4. POST добавление кометы с фото и видео",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201 || pm.response.code === 200) {",
              "    pm.collectionVariables.set('comet_id', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/comets",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "comets"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "comet_name",
              "value": "13P/Ольберса",
              "type": "text"
            },
            {
              "key": "comet_photo",
              "type": "file",
              "src": "C:\\Projects\\RIP\\Backend\\media\\halley.jpg"
            },
            {
              "key": "comet_video",
              "type": "file",
              "src": "C:\\Projects\\RIP\\Backend\\media\\halley.mp4"
            }
          ]
        },
        "description": "Создаёт черновик. Файлы загружаются в Minio, в БД сохраняются их имена."
      }
    },
    {
      "name": "5. PUT публикация кометы",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{base_url}}/api/comets/{{comet_id}}/publish",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "comets",
            "{{comet_id}}",
            "publish"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"comet_description\": \"Короткопериодическая комета, открытая Генрихом Ольберсом в 1815 году.\",\n  \"orbital_period\": 69.5,\n  \"orbit_eccentricity\": 0.93\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. DELETE удаление кометы",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{base_url}}/api/comets/{{comet_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "comets",
            "{{comet_id}}"
          ]
        },
        "description": "Логическое удаление, только своей кометы."
      }
    },
    {
      "name": "7. POST лайк",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/comets/1/like",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "comets",
            "1",
            "like"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"like\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "like: 1 — поставить, 0 — отменить."
      }
    },
    {
      "name": "8. POST регистрация",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/users/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "register"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"orlova\",\n  \"full_name\": \"Анна Орлова\",\n  \"password\": \"secret123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "9. POST аутентификация",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/users/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "login"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"frolov\",\n  \"password\": \"comets2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        },
        "description": "Возвращает JWT. Тест-скрипт сохраняет access_token в переменную коллекции token."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set('token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "10. POST деавторизация",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/users/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "logout"
          ]
        },
        "description": "Заносит текущий токен в чёрный список Redis."
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "comet_id",
      "value": "11"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  }
}